<div class="emptyState">
    <p>Нет заметок</p>
</div>

<div class="note__breadcrumb">
    <span class="note__breadcrumbItem">Библиотека</span>
    <span class="note__breadcrumbItem note__breadcrumbItem--current"></span>		
</div>
    
<article class="note__content">
    <h1 class="note__title"></h1>
    <div class="note__body">
        {{#each activeBlocks}}
        <div class="note__block" data-block-id="{{id}}" contenteditable="true">{{content}}</div>
        {{/each}}
    </div>
</article>
<div class="note__actions"> 
    <button class="note__addBlockBtn">
        <img src="/icons/block_add.svg" class="icon" />
    </button>
    <button class="note__dragBlock">
        <img src="/icons/block_drag.svg" class="icon" />
    </button>
</div>