<div class="profile-avatar">
    <img src="{{avatarUrl}}" alt="Avatar" class="profile-avatar__image" data-avatar-image>
    <div class="profile-avatar__actions">
        <input type="file" 
               data-action="avatar-input" 
               accept=".png,.jpg,.jpeg,.webp" 
               style="display: none;">
        <button type="button" class="profile-avatar__button profile-avatar__button--upload" data-action="upload-avatar">
            Загрузить
        </button>
        <button type="button" class="profile-avatar__button profile-avatar__button--delete" data-action="delete-avatar" {{#unless hasAvatar}}style="display: none;"{{/unless}}>
            Удалить
        </button>
    </div>
    <div class="profile-avatar__description">
        <span class="profile-avatar__description-text">
            Размер фотографии не должен превышать 5МБ.
            Допустимые расширения: .png, .jpg, .webp.
            Соотношение сторон: 1:1.
        </span>
    </div>
    <div class="profile-avatar__error" data-error></div>
</div>