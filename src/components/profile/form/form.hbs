<form class="profile-form" id="{{formId}}" novalidate>
    <div class="profile-form__controls">
        <div class="form__input {{#if fields.0.disabled}}form__input--disabled{{/if}}">
            <label for="{{fields.0.name}}" class="input__label profile-form__label">{{fields.0.label}}</label>
            <input type="{{fields.0.type}}"
                    name="{{fields.0.name}}"
                    id="{{fields.0.name}}"
                    value="{{fields.0.value}}"
                    placeholder="{{fields.0.placeholder}}"
                    autocomplete="{{fields.0.autocomplete}}"
                    {{#if fields.0.required}}required{{/if}}
                    {{#if fields.0.disabled}}disabled{{/if}}
                    class="input {{#if fields.0.disabled}}input--disabled{{/if}}">
            <span class="input__error" data-field-error></span>
        </div>
        <button type="submit" class="profile__button" {{#if fields.0.disabled}}disabled{{/if}}>
            {{buttonText}}
        </button>
    </div>
</form>
