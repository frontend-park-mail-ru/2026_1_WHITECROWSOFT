<div class="formattingPopup">
    <div class="formattingPopup__row">
        <input type="text" class="formattingPopup__input" value="{{font}}" placeholder="Inter" readonly>
        <button class="formattingPopup__button formattingPopup__button--disabled" data-action="fontDropdown" disabled>
            {{{svgIcon "expand" class="formattingPopup__icon" alt="Expand font"}}}
        </button>
        <button class="formattingPopup__button {{#if isBold}}formattingPopup__button--active{{/if}}" data-action="bold">
            {{{svgIcon "text_bold" class="formattingPopup__icon" alt="Bold"}}}
        </button>
        <button class="formattingPopup__button {{#if isItalic}}formattingPopup__button--active{{/if}}" data-action="italic">
            {{{svgIcon "text_italica" class="formattingPopup__icon" alt="Italic"}}}
        </button>
        <button class="formattingPopup__button {{#if isUnderline}}formattingPopup__button--active{{/if}}" data-action="underline">
            {{{svgIcon "text_underscore" class="formattingPopup__icon" alt="Underline"}}}
        </button>
        <button class="formattingPopup__button {{#if isStrike}}formattingPopup__button--active{{/if}} formattingPopup__button--disabled" disabled data-action="strike">
            {{{svgIcon "text_cross" class="formattingPopup__icon" alt="Strike"}}}
        </button>
    </div>
    <div class="formattingPopup__row">
        <input type="number" class="formattingPopup__input" min="8" max="96" value="{{fontSize}}" placeholder="14" readonly>
        <button class="formattingPopup__button formattingPopup__button--disabled" disabled data-action="sizeDropdown">
            {{{svgIcon "expand" class="formattingPopup__icon" alt="Expand size"}}}
        </button>
        <button class="formattingPopup__button formattingPopup__button--disabled" disabled data-action="color">
            {{{svgIcon "text_color" class="formattingPopup__icon" alt="Color"}}}
        </button>
        <button class="formattingPopup__button formattingPopup__button--disabled" disabled data-action="link">
            {{{svgIcon "text_link" class="formattingPopup__icon" alt="Link"}}}
        </button>
        <button class="formattingPopup__button formattingPopup__button--disabled" disabled data-action="code">
            {{{svgIcon "text_code" class="formattingPopup__icon" alt="Code"}}}
        </button>
        <button class="formattingPopup__button formattingPopup__button--disabled" disabled data-action="formula">
            {{{svgIcon "text_formula" class="formattingPopup__icon" alt="Formula"}}}
        </button>
    </div>
</div>