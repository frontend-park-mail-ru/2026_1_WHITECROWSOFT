<div class="formattingPopup">
    <div class="formattingPopup__row">
        <button class="formattingPopup__button {{#if isBold}}formattingPopup__button--active{{/if}}" data-action="bold">
            {{{svgIcon "text_bold" class="formattingPopup__icon" alt="Bold"}}}
        </button>
        <button class="formattingPopup__button {{#if isItalic}}formattingPopup__button--active{{/if}}" data-action="italic">
            {{{svgIcon "text_italica" class="formattingPopup__icon" alt="Italic"}}}
        </button>
        <button class="formattingPopup__button {{#if isUnderline}}formattingPopup__button--active{{/if}}" data-action="underline">
            {{{svgIcon "text_underscore" class="formattingPopup__icon" alt="Underline"}}}
        </button>
        <button class="formattingPopup__button {{#if isStrike}}formattingPopup__button--active{{/if}} formattingPopup__button--disabled" disabled data-action="strike">
            {{{svgIcon "text_cross" class="formattingPopup__icon" alt="Strike"}}}
        </button>
    </div>
</div>