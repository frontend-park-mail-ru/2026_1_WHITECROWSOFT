<div class="popup__wrapper">
    <div class="popup__container">
        <h3>Заметка</h3>
        <div class="popup__operations">
            <button class="popup__button" data-action="pin">
                {{#if isFavorite}}
                {{{svgIcon "unpin" class="popup__icon" alt="Unpin"}}} Убрать из избранного
                {{else}}
                {{{svgIcon "pin" class="popup__icon" alt="Pin"}}} В избранное
                {{/if}}
            </button>
            <button class="popup__button" data-action="rename">
                {{{svgIcon "rename" class="popup__icon" alt="Rename"}}}
                Переименовать
            </button>
            <button class="popup__button" data-action="share">
                {{{svgIcon "share" class="popup__icon" alt="Share"}}}
                Поделиться
            </button>
            <button class="popup__button" data-action="pdf">
                {{{svgIcon "pdf" class="popup__icon" alt="PDF"}}}
                Экспорт в PDF
            </button>
            <button class="popup__button" data-action="delete">
                {{{svgIcon "trash" class="popup__icon" alt="Delete"}}}
                Удалить
            </button>
        </div>
    </div>
</div>