<div class="popupContainer">
    <h3>Заметка</h3>
    <div class="popupOperations">
        <button id="pinBtn" class="pinButton popupButton" data-action="pin">
			<img src="/icons/pin.svg" class="icon" />
			В избранное
		</button>
        <button id="renameBtn" class="renameButton popupButton" data-action="rename">
			<img src="/icons/rename.svg" class="icon" />
			Переименовать
		</button>
        <button id="deleteBtn" class="deleteButton popupButton" data-action="delete">
			<img src="/icons/trash.svg" class="icon" />
			Удалить
		</button>
    </div>
</div>