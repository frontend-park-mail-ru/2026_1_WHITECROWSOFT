<div class="popup__wrapper">
    <div class="popup__container">
        <h3>Заметка</h3>
        <div class="popup__operations">
            <button class="popup__button popup__button--disabled" data-action="pin">
                <img src="/icons/pin.svg" class="popup__icon" />
                В избранное
            </button>
            <button class="popup__button" data-action="rename">
                <img src="/icons/rename.svg" class="popup__icon" />
                Переименовать
            </button>
            <button class="popup__button" data-action="delete">
                <img src="/icons/trash.svg" class="popup__icon" />
                Удалить
            </button>
        </div>
    </div>
</div>