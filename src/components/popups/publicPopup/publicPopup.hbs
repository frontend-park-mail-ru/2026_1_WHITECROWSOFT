<div class="popup__wrapper">
    <div class="popup__container">
        <h3>Открыть публичную заметку</h3>
        <div class="popup__form">
            <input type="text" class="popup__input" placeholder="Введите ID заметки" />
            <div class="popup__form-actions">
                <button class="popup__button" data-action="cancel">Отмена</button>
                <button class="popup__button popup__button--primary" data-action="submit">Открыть</button>
            </div>
        </div>
    </div>
</div>
