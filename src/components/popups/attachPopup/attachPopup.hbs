<div class="popup__wrapper">
	<div class="popup__container">
		<h3>Добавить</h3>
		<div class="popup__operations">
			<button id="textBtn" class="popup__button" data-action="text">
				{{{svgIcon "attach_text" class="popup__icon" alt="Text"}}}
				Текст
			</button>
			<button id="pictureBtn" class="popup__button" data-action="picture">
				{{{svgIcon "attach_picture" class="popup__icon" alt="Picture"}}}
				Изображение
			</button>
			<button id="musicBtn" class="popup__button" data-action="music">
				{{{svgIcon "attach_music" class="popup__icon" alt="Music"}}}
				Музыка
			</button>
			<button id="videoBtn" class="popup__button" data-action="video">
				{{{svgIcon "attach_video" class="popup__icon" alt="Video"}}}
				Видео
			</button>
			{{#unless isShared}}
			<button id="subnoteBtn" class="popup__button" data-action="subnote">
				{{{svgIcon "document" class="popup__icon" alt="Subnote"}}}
				Подзаметка
			</button>
			{{/unless}}
		</div>
	</div>
</div>