<div class="popup__wrapper">
	<div class="popup__container">
		<h3>Добавить</h3>
		<div class="popup__operations">
			<button id="textBtn" class="popup__button" data-action="text">
				<img src="/icons/attach_text.svg" class="popup__icon" />
				Текст
			</button>
			<button id="pictureBtn" class="popup__button" data-action="picture">
				<img src="/icons/attach_picture.svg" class="popup__icon" />
				Изображение
			</button>
			<button id="tableBtn" class="popup__button popup__button--disabled" data-action="table">
				<img src="/icons/attach_table.svg" class="popup__icon" />
				Таблица
			</button>
			<button id="musicBtn" class="popup__button" data-action="music">
				<img src="/icons/attach_music.svg" class="popup__icon" />
				Музыка
			</button>
			<button id="videoBtn" class="popup__button" data-action="video">
				<img src="/icons/attach_video.svg" class="popup__icon" />
				Видео
			</button>
			<button id="subnoteBtn" class="popup__button" data-action="subnote">
				<img src="/icons/document.svg" class="popup__icon" />
				Подзаметка
			</button>
		</div>
	</div>
</div>