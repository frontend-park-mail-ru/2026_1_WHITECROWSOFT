<div class="cover-block-root">
    {{#if coverUrl}}
        <div class="note__cover">
            <img src="{{coverUrl}}" alt="coverImage" class="note__cover-image" data-cover-image>
            <button class="note__cover-change-btn" data-action="changeCover">
                Изменить
            </button>
            <button class="note__cover-remove-btn" data-action="removeCover">
                Удалить
            </button>
        </div>
    {{/if}}
</div>