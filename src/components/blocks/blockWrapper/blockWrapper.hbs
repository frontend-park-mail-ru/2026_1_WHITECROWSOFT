<div class="note__block-wrapper" 
     data-block-id="{{blockId}}" 
     tabindex="-1">
    <div class="note__block-container"></div>
    <div class="note__block-actions">
        <button class="note__block-add-btn" data-action="add" title="Добавить новый блок">
            {{{svgIcon "block_add" class="icon" alt="Add block"}}}
        </button>
        <button class="note__block-drag-btn" data-action="drag" draggable="true" title="Перетащить блок">
            {{{svgIcon "block_drag" class="icon" alt="Drag block"}}}
        </button>
    </div>
</div>
