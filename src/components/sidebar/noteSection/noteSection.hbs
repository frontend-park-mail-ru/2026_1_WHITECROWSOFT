<div class="note-section">
    <div class="note-section__header">
        <h3 class="note-section__title">{{title}}</h3>
    </div>
    
    <div class="note-section__content">
        <div class="note-section__tree" data-tree-container></div>
        <div class="note-section__empty {{#if hasNotes}}hidden{{/if}}">{{emptyMessage}}</div>
    </div>
</div>