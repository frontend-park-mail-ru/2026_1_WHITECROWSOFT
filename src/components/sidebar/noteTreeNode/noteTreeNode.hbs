<div class="note-tree-node" data-note-id="{{id}}">
    <div class="note-tree-node__content {{#if isActive}}note-tree-node__content--active{{/if}}">
        <div class="note-tree-node__indent" style="width: {{level}}px;"></div>
        {{#if hasChildren}}
            <button class="note-tree-node__toggle" data-action="toggle">
                {{#if isExpanded}}
                {{{svgIcon "expand" class="note-tree-node__toggle-icon note-tree-node__toggle-icon--rotated" alt="Toggle"}}}
                {{else}}
                {{{svgIcon "expand" class="note-tree-node__toggle-icon" alt="Toggle"}}}
                {{/if}}
            </button>
            {{{svgIcon (ternary icon icon "document") class="note-tree-node__icon" alt="Note icon"}}}
        {{else}}
            {{{svgIcon (ternary icon icon "document") class="note-tree-node__icon" alt="Note icon"}}}
        {{/if}}
        
        <span class="note-tree-node__title" data-name="noteTitle">{{title}}</span>
        <div class="note-tree-node__actions">
            <button class="note-tree-node__action" data-action="addSubnote" title="Добавить подзаметку">
                {{{svgIcon "add" class="icon" alt="Add subnote"}}}
            </button>
            <button class="note-tree-node__action" data-action="settings" title="Настройки">
                {{{svgIcon "more" class="icon" alt="More"}}}
            </button>
        </div>
    </div>
    {{#if hasChildren}}
        <div class="note-tree-node__children" data-children-container style="display: {{#if isExpanded}}block{{else}}none{{/if}};">
            {{#each children}}
                <div data-child-node="{{id}}"></div>
            {{/each}}
        </div>
    {{/if}}
</div>
