<aside class="sidebar">
	<div class="sidebar__header">
		<h1 class="logo__title">Noterian</h1>
	</div>

	<div class="sidebar__actionMenu">
		<div class="search search--disabled">
		    <img src="/icons/search.svg" class="icon search__icon" />
			<input
				type="text"
				class="search__input input input--disabled"
				placeholder="Поиск"
				value="{{searchQuery}}"
			/>
		</div>
		<button id="profileBtn" class="profileButton sidebar__btn" data-action="profile">
			<img src="/icons/profile.svg" class="icon" />
			<span id="profile-username">{{user.username}}</span>
		</button>
		<button id="homeButton" class="homeButton sidebar__btn" data-action="home">
			<img src="/icons/home.svg" class="icon" />
			Главная
		</button>
		<button class="sidebar__btn sidebar__btn--disabled">
			<img src="/icons/bookmark.svg" class="icon" />
			Библиотека
		</button>
	</div>

	<hr class="sidebar__barrier" />

	<div class="sidebar__notesList">
		{{#each notes}}
			<div class="sidebar__noteItem {{#if (eq this.ID ../activeNoteId)}}sidebar__noteItem--active{{/if}}" data-note-id="{{this.ID}}">
				<img src="/icons/document.svg" class="icon" />
				<div class="sidebar__noteItemTitle">{{this.title}}</div>
				<div class="sidebar__noteItemActions">
					<button class="sidebar__noteActionBtn addSubnoteBtn" data-action="addSubnote" data-note-id="{{this.ID}}">
						<img src="/icons/add.svg" class="icon" />
					</button>
					<button class="sidebar__noteActionBtn settingsBtn" data-action="settings" data-note-id="{{this.ID}}">
						<img src="/icons/more.svg" class="icon" />
					</button>
				</div>
			</div>
		{{else}}
			<div class="emptyNotes">
				<p>У вас пока нет заметок</p>
			</div>
		{{/each}}
	</div>

    <button class="sidebar__btn newNoteButton" data-action="newNote">
        <img src="/icons/add.svg" class="icon" />
        Новая Заметка
    </button>

	<hr class="sidebar__barrier" />

	<button class="sidebar__btn bottom sidebar__btn--disabled">
		<img src="/icons/settings.svg" class="icon" />
		Настройки
	</button>

	<button class="sidebar__btn bottom" data-action="support">
		<img src="/icons/support.svg" class="icon" />
		Поддержка
	</button>
</aside>
