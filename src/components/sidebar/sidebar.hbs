<aside class='sidebar'>
	<div class='sidebar__header'>
		<h1 class='logo__title'>Noterian</h1>
		<button
			class='sidebar__headerToggle'
			data-action='toggleSidebar'
			aria-label='Свернуть боковую панель'
		>
			{{{svgIcon "menu" class="icon icon--big" alt="Toggle Sidebar"}}}
		</button>
	</div>
	<div class='sidebar__actionMenu'>
		<div class='search search--disabled'>
			{{{svgIcon "search" class="icon search__icon" alt="Search"}}}
			<input
				type='text'
				class='search__input input input--disabled'
				placeholder='Поиск'
			/>
		</div>
		<button
			id='profileBtn'
			class='profileButton sidebar__btn'
			data-action='profile'
		>
			<img
				src='{{user.avatarUrl}}'
				alt='Profile'
				class='sidebar__avatar'
				data-sidebar-avatar
			/>
			<span id='profile-username'>{{user.username}}</span>
		</button>
	</div>
	<hr class='sidebar__barrier' />
	<div class='sidebar__sections'>
		<div class='sidebar__section' data-section='favorites'></div>
		<div class='sidebar__section' data-section='personal'></div>
		<div class='sidebar__section' data-section='shared'></div>
	</div>
	<button class='sidebar__btn newNoteButton' data-action='newNote'>
		{{{svgIcon "add" class="icon" alt="New note"}}}
		Новая Заметка
	</button>
	<div
		class='sidebar__resizeHandle'
		data-action='resize'
		role='separator'
		aria-orientation='vertical'
		aria-label='Изменить ширину боковой панели'
	></div>
</aside>
