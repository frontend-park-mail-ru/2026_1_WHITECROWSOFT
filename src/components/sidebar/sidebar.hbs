<aside class="sidebar">
	<div class="sidebarHeader">
		<h1 class="appTitle">Noterian</h1>
	</div>

	<div class="actionMenu">
		<div class="searchBox disabled">
		    <img src="/icons/search.svg" class="icon searchIcon" />
			<input
				type="text"
				class="searchInput"
				placeholder="Поиск"
				value="{{searchQuery}}"
			/>
		</div>
		<button id="profileBtn" class="profileButton sidebarButton" data-action="profile">
			<img src="/icons/profile.svg" class="icon" />
			<span id="profile-username">{{user.username}}</span>
		</button>
		<button id="homeButton" class="homeButton sidebarButton" data-action="home">
			<img src="/icons/home.svg" class="icon" />
			Главная
		</button>
		<button class="sidebarButton disabled">
			<img src="/icons/bookmark.svg" class="icon" />
			Библиотека
		</button>
	</div>

	<hr class="barrier" />

	<div class="notesList">
		{{#each notes}}
			<div class="noteItem {{#if (eq this.ID ../activeNoteId)}}active{{/if}}" data-note-id="{{this.ID}}">
				<img src="/icons/document.svg" class="icon" />
				<div class="noteItemTitle">{{this.title}}</div>
				<div class="noteItemActions">
					<button class="noteActionBtn addSubnoteBtn" data-action="addSubnote" data-note-id="{{this.ID}}">
						<img src="/icons/add.svg" class="icon" />
					</button>
					<button class="noteActionBtn settingsBtn" data-action="settings" data-note-id="{{this.ID}}">
						<img src="/icons/more.svg" class="icon" />
					</button>
				</div>
			</div>
		{{else}}
			<div class="emptyNotes">
				<p>У вас пока нет заметок</p>
			</div>
		{{/each}}
	</div>

	<div class="newNoteContainer">
        <button class="sidebarButton newNoteButton" data-action="newNote">
            <img src="/icons/add.svg" class="icon" />
            Новая Заметка
        </button>
    </div>

	<hr class="barrier" />
	
	<button class="sidebarButton bottom disabled">
		<img src="/icons/settings.svg" class="icon" />
		Настройки
	</button>
</aside>
