<div class="sidebar__noteItem {{#if isActive}}sidebar__noteItem--active{{/if}}" data-name="noteItem" data-note-id="{{note.id}}">
	<img src="/icons/document.svg" class="icon" />
	<div class="sidebar__noteItemTitle" data-name="noteItemTitle">{{note.title}}</div>
	<div class="sidebar__noteItemActions" data-zone="note-actions">
		<button class="sidebar__noteActionBtn addSubnoteBtn" data-action="addSubnote" data-note-id="{{note.id}}">
			<img src="/icons/add.svg" class="icon" />
		</button>
		<button class="sidebar__noteActionBtn settingsBtn" data-action="settings" data-note-id="{{note.id}}">
			<img src="/icons/more.svg" class="icon" />
		</button>
	</div>
</div>