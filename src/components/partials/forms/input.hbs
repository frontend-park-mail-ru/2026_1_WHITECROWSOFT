<div class="form__input">
	<label for="{{name}}" class="input__label">{{label}}</label>
	<div class="input__wrapper {{#if disabled}}input__wrapper--disabled{{/if}}">
		<input
			type="{{#if (eq type "password")}}{{#if showPassword}}text{{else}}password{{/if}}{{else}}{{type}}{{/if}}"
			name="{{name}}"
			value="{{value}}"
			placeholder="{{placeholder}}"
			autocomplete="{{autocomplete}}"
			{{#if minlength}}minlength="{{minlength}}"{{/if}}
            {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
			required
			class="input {{#if error}}input--error{{/if}} {{#if disabled}}input--disabled{{/if}}"
            {{#if (eq withrequirements "true")}}data-registration-password{{/if}}
		/>
		{{#if (eq type "password")}}
		<span class="passwordToggle" data-toggle-password>
			{{{svgIcon "visibility-off" class="icon input__eyeIcon input__eyeIcon--open" alt="Hide password" style="display: {{#if (eq name \"password\")}}{{#if ../showPassword}}none{{else}}block{{/if}}{{else if (eq name \"passwordConfirm\")}}{{#if ../showPasswordConfirm}}none{{else}}block{{/if}}{{/if}}"}}}
			{{{svgIcon "visibility" class="icon input__eyeIcon input__eyeIcon--closed" alt="Show password" style="display: {{#if (eq name \"password\")}}{{#if ../showPassword}}block{{else}}none{{/if}}{{else if (eq name \"passwordConfirm\")}}{{#if ../showPasswordConfirm}}block{{else}}none{{/if}}{{/if}}"}}}
		</span>
		{{/if}}
        {{#if (eq withrequirements "true") }}
        <div class="validator" style="display:none" data-password-validator>
        </div>
        {{/if}}
	</div>
	{{#if (eq witherror "true")}}
	<span
		class="input__error"
		data-field-error="{{name}}"
		style="visibility: hidden"
		role="alert"
	></span>
	{{/if}}
</div>
